# Required for Groq generation and optional RAGAS evaluation.
GROQ_API_KEY=your_groq_api_key

# Runtime model configuration.
GROQ_GENERATION_MODEL=llama-3.1-8b-instant
GROQ_EVALUATOR_MODEL=llama-3.1-8b-instant
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval and context controls.
RAG_DATA_DIR=data
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=150
RAG_RETRIEVAL_K=1
RAG_MAX_CONTEXT_CHARS=2500
RAG_MAX_ANSWER_TOKENS=120
RAG_TEMPERATURE=0.3

# Set JSON_LOGS=true for structured JSON logs in deployed processes.
LOG_LEVEL=INFO
JSON_LOGS=false
